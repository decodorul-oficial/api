{
  "version": 2,
  "builds": [
    {
      "src": "api/src/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/src/**"]
      }
    },
    {
      "src": "api/src/api/cron/recurring-billing.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/src/api/cron/trial-processing.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/src/api/cron/payment-retries.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/src/api/cron/full-cleanup.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/src/api/cron/monitoring.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/src/api/cron/alerts-digest-slot.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/src/api/cron/alerts-ops-healthcheck.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/src/api/cron/instant-watch-alerts.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "rewrites": [
    {
      "source": "/graphql",
      "destination": "/api/src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/src/api/cron/recurring-billing.js",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/src/api/cron/trial-processing.js",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/src/api/cron/alerts-ops-healthcheck.js",
      "schedule": "0 7 * * 1-5"
    }
  ]
}