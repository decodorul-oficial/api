# =============================================================================
# CONFIGURAȚIA PENTRU SUPABASE (OBLIGATORIE)
# =============================================================================
# Obține aceste valori din dashboard-ul Supabase -> Settings -> API
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY este o cheie cu privilegii depline
# și trebuie tratată cu maximă securitate - NU o expune în frontend!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# CONFIGURAȚIA PENTRU MEDIUL DE DEZVOLTARE
# =============================================================================
# Setează mediul de dezvoltare (development/production)
# În producție, aceasta va activa automat optimizările de performanță
# și măsurile de securitate (dezactivarea GraphQL Introspection)
NODE_ENV=development

# Portul pentru serverul local (nu se folosește pe Vercel)
PORT=4000

# Configurația pentru CORS (pentru producție, specificați domeniile exacte)
CORS_ORIGIN=*

# Configurația pentru logging
LOG_LEVEL=info

# Configurația pentru rate limiting (opțional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# CONFIGURAȚIA PENTRU CRIPTAREA PAROLELOR (OBLIGATORIE)
# =============================================================================
# Cheia folosită pentru criptarea/decriptarea parolelor între frontend și backend,
# webhook-uri și cereri server-to-server (ex. sitemap). Trebuie să aibă cel puțin 32 de caractere.
# Pentru getStiri cu limit > 10 fără JWT, trimiteți header X-Internal-API-Key cu această valoare.
INTERNAL_API_KEY=your-secure-internal-api-key-here-minimum-32-characters

# Limit maxim pentru getStiri când se folosește X-Internal-API-Key valid (implicit 100, max 500)
INTERNAL_GET_STIRI_MAX_LIMIT=500

# Configurația pentru securitate (opțional)
MAX_REQUEST_SIZE=10mb
MAX_QUERY_COMPLEXITY=1000
MAX_QUERY_DEPTH=7

# =============================================================================
# CONFIGURAȚIA PENTRU API BASE URL (OBLIGATORIE)
# =============================================================================
# URL-ul de bază pentru API (pentru localhost și producție)
API_BASE_URL=http://localhost:4000

# =============================================================================
# CONFIGURAȚIA PENTRU RECAPTCHA v3 (OBLIGATORIE)
# =============================================================================
# Obține aceste valori din Google reCAPTCHA Console
# Site Key: pentru frontend (public)
# Secret Key: pentru backend (privat)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_MIN_SCORE=0.5

# =============================================================================
# PLĂȚI — Stripe (documentație: docs/STRIPE_PAYMENTS.md)
# =============================================================================
# În producție, lasă false până la activarea oficială a checkout-ului.
PAYMENTS_ENABLED=false

# Cheie secretă API (sk_…). Niciodată în frontend sau NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PRODUCTION_SECRET_KEY=your_stripe_production_secret_key_here
STRIPE_SANDBOX_SECRET_KEY=your_stripe_sandbox_secret_key_here

# Webhook: semnătură endpoint (whsec_…). Doar pe server. Alias: STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SIGNING_SECRET=your_stripe_webhook_signing_secret_here
STRIPE_WEBHOOK_SIGNING_SECRET_PRODUCTION=your_stripe_webhook_signing_secret_production_here
STRIPE_WEBHOOK_SIGNING_SECRET_SANDBOX=your_stripe_webhook_signing_secret_sandbox_here

STRIPE_API_VERSION=2026-01-28.clover

# Întoarcere după Checkout (același URL pentru succes și renunțare)
STRIPE_SUCCESS_URL=http://localhost:3000/profile?checkout=success
# SAU: FRONTEND_URL=http://localhost:3000 și opțional STRIPE_CHECKOUT_RETURN_PATH=/payment/stripe-result

STRIPE_CUSTOMER_PORTAL_RETURN_URL=http://localhost:3000/
# STRIPE_CHECKOUT_LOCALE=ro

# Apple Pay: Dashboard → Payment methods → Apple Pay + domeniu (HTTPS în producție)

# DB: payments.subscription_tiers.stripe_price_id = Price ID Stripe (price_…) SAU lookup_key pe Price

# =============================================================================
# OBLIO — facturi fiscale (docs/OBLIO_INVOICES.md)
# =============================================================================
# Local/sandbox: OBLIO_ENABLED=false până ai serie de test.
OBLIO_ENABLED=false
OBLIO_EMAIL=your_oblio_account_email
OBLIO_SECRET=your_oblio_api_secret
OBLIO_CIF=RO12345678
OBLIO_SERIES_NAME=FCT
OBLIO_VAT_PERCENTAGE=21
OBLIO_VAT_NAME=Normala
